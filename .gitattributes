# Migration files are fingerprinted (ADR 0007). Keep their line endings the same on
# every platform, or the checksum of an applied migration would differ per checkout.
*.sql text eol=lf

# The sample filings and the expected load output are compared byte for byte by the
# tests, so their line endings must not depend on the platform either.
tests/fixtures/** text eol=lf

# The decision files are read row by row and shipped inside the package; keep them
# the same on every platform too.
src/pyvalue/universe/decisions/*.csv text eol=lf
